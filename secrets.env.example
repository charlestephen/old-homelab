# Copy this file to secrets.env, fill it in, and keep it out of version control (chmod 600).
# scripts/gen-secrets.sh creates secrets.env with random values for the ones that can be generated.
# Each name becomes a Podman secret that the containers read; the values never appear in a unit file.

# ---- every host that runs Traefik ----
# password for the Traefik API and dashboard (user: TRAEFIK_ADMIN_USER)
traefik_admin_password=CHANGE_ME
# proxy and server only: the key Traefik Manager shows once when you add this host under Settings > Agents.
# Leave it empty until then; the agent is skipped while it is empty.
tma_api_key=

# ---- dns-node ----
dns_admin_password=CHANGE_ME
dns_pfx_password=CHANGE_ME
dnsdist_web_password=CHANGE_ME
dnsdist_console_key=CHANGE_ME
logdb_password=CHANGE_ME
cf_token=CHANGE_ME
cf_account_id=CHANGE_ME
# optional: a Slack incoming webhook URL for keepalived failover messages (leave empty to skip)
slack_keepalived_webhook=

# ---- core ----
postgres_password=CHANGE_ME
cf_dns_api_token=CHANGE_ME
pocket_id_encryption_key=CHANGE_ME
# Traefik Manager (core): session key, and the key that encrypts the secrets it stores
tm_secret_key=CHANGE_ME
tm_otp_encryption_key=CHANGE_ME
grafana_admin_password=CHANGE_ME
# optional: a Tailscale auth key for the Forgejo sidecar (leave empty to skip)
forgejo_tailscale_authkey=

# ---- forgejo-runner ----
# create it in Forgejo: Site administration > Actions > Runners > Create new runner
runner_registration_token=CHANGE_ME

# ---- proxy ----
crowdsec_bouncer_key=CHANGE_ME
cloudflared_public_token=CHANGE_ME
geoip_account_id=CHANGE_ME
geoip_license_key=CHANGE_ME
pgbouncer_auth_password=CHANGE_ME
authentik_db_password=CHANGE_ME
authentik_secret_key=CHANGE_ME
pocket_id_db_password=CHANGE_ME
smtp_password=CHANGE_ME
kutt_jwt_secret=CHANGE_ME
kutt_oidc_client_secret=CHANGE_ME
geometrikks_db_password=CHANGE_ME
geometrikks_admin_password=CHANGE_ME
geometrikks_carto_key=CHANGE_ME

# ---- server ----
pgadmin_password=CHANGE_ME
hishtory_db_password=CHANGE_ME
plex_claim=
open_webui_secret_key=CHANGE_ME
open_webui_oidc_client_secret=CHANGE_ME
open_webui_admin_password=CHANGE_ME
code_server_sudo_password=CHANGE_ME
dockhand_token=CHANGE_ME
# media stack
vpn_wireguard_key=CHANGE_ME
gluetun_control_password=CHANGE_ME
qbittorrent_password=CHANGE_ME

# Managed by old-homelab. Rendered from roles/proxy/files/traefik.yml.tmpl.
log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

# CrowdSec and GeoMetrikks read this file, so it stays JSON
accessLog:
  filePath: /var/log/traefik/access.log
  format: json

# The API and dashboard are only reachable through the basic-auth router in dynamic/traefik-api.yml
api:
  dashboard: true

ping: {}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http3: {}
    forwardedHeaders:
      trustedIPs:
        - "@@CONTAINER_NET_SUBNET@@"
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.@@PROXY_DOMAIN@@"
  traefik:
    address: ":8080"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "@@ADMIN_EMAIL@@"
      storage: /etc/traefik/acme/letsencrypt.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "@@ACME_RESOLVERS@@"

# Plugins are downloaded when Traefik starts, so the host needs outbound access to plugins.traefik.io
experimental:
  plugins:
    crowdsec:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      version: v1.6.0
    geoblock:
      moduleName: github.com/PascalMinder/geoblock
      version: v0.3.7

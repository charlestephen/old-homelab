# Managed by old-homelab. Rendered from roles/core/files/traefik.yml.tmpl.
log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log

# The API and dashboard are only reachable through the basic-auth router in dynamic/traefik-api.yml
api:
  dashboard: true

ping: {}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http3: {}
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.@@CORE_DOMAIN@@"
  traefik:
    address: ":8080"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "@@ADMIN_EMAIL@@"
      storage: /etc/traefik/acme/letsencrypt.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "@@ACME_RESOLVERS@@"
